<% content_for :title, "Airlines" %>

<h1>Airlines</h1>
<p>Airlines that operate routes between Canadian airports.</p>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th scope="col">Airline</th>
        <th scope="col">IATA</th>
        <th scope="col">ICAO</th>
        <th scope="col">Country</th>
        <th scope="col" class="text-end">Routes</th>
      </tr>
    </thead>
    <tbody>
      <% @airlines.each do |airline| %>
        <tr>
          <td><%= link_to airline.name, airline %></td>
          <td><%= airline.iata_code %></td>
          <td><%= airline.icao_code %></td>
          <td><%= airline.country %></td>
          <td class="text-end"><%= airline.routes_count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= paginate @airlines %>
