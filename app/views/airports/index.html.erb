<% content_for :title, "Airports" %>

<h1>Airports</h1>

<%= render "shared/search_form", provinces: @provinces %>

<% if params[:q].present? || @selected_province %>
  <p>
    Showing <%= pluralize(@airports.total_count, "result") %>
    <% if params[:q].present? %>for “<strong><%= params[:q] %></strong>”<% end %>
    <% if @selected_province %>in <strong><%= @selected_province.name %></strong><% end %>.
    <%= link_to "Clear search", airports_path %>
  </p>
<% end %>

<% if @airports.empty? %>
  <div class="alert alert-warning">No airports matched your search.</div>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th scope="col">Airport</th>
          <th scope="col">Code</th>
          <th scope="col">City</th>
          <th scope="col">Province / territory</th>
          <th scope="col">Type</th>
        </tr>
      </thead>
      <tbody>
        <% @airports.each do |airport| %>
          <tr>
            <td><%= link_to airport.name, airport %></td>
            <td><%= airport.display_code %></td>
            <td><%= airport.municipality %></td>
            <td><%= link_to airport.province.name, airport.province %></td>
            <td><%= airport.type_label %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @airports %>
<% end %>
